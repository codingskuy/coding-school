{
  "name": "@codingskuy/coding-school",
  "version": "2.2.2",
  "description": "CodingSchool — Dual-agent AI Engineering Mentor plugin for OpenCode. Teacher agent (student diagnosis, scaffolding, competency tracking) + Coach agent (code review, architecture, GRC, project timeline).",
  "type": "module",
  "bin": {
    "coding-school": "./scripts/cli.mjs"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE.md",
    ".claude-plugin/",
    "claude-code/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/tui.ts src/gate-check.ts src/mcp.ts src/pi.ts src/dsh-setup.ts --outdir dist --external @opencode-ai/plugin --external @opentui/solid --external '@earendil-works/*' --target node && tsc --emitDeclarationOnly --outDir dist",
    "build:quick": "bun build src/index.ts --outdir dist --external @opencode-ai/plugin --target node",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.mjs",
    "setup": "node scripts/cli.mjs setup",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist",
    "gen:claude-code": "bun scripts/gen-claude-code.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.0",
    "date-fns": "^3.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentui/core": "0.4.3",
    "@opentui/solid": "0.4.3",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "zod": "4.6.7"
  },
  "keywords": [
    "opencode",
    "plugin",
    "coding-school",
    "mentor",
    "learning",
    "tutorial",
    "engineering",
    "competency",
    "grc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codingskuy/coding-school.git"
  },
  "homepage": "https://github.com/codingskuy/coding-school#readme",
  "bugs": {
    "url": "https://github.com/codingskuy/coding-school/issues"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "pi": {
    "extensions": [
      "./dist/pi.js"
    ]
  }
}
